{
  "entities": {
    "InspectionActivity": {
      "title": "Inspection Activity",
      "description": "Log entry of a QA inspection action performed by an inspector",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "moduleCode": { "type": "string" },
        "moduleTitleTh": { "type": "string" },
        "moduleTitleEn": { "type": "string" },
        "inspector": { "type": "string" },
        "batchLot": { "type": "string" },
        "result": { "type": "string", "enum": ["PASS", "FAIL", "PENDING", "REJECT"] },
        "defectCount": { "type": "number" },
        "remarks": { "type": "string" }
      },
      "required": ["id", "timestamp", "moduleCode", "inspector", "batchLot", "result"]
    },
    "BilletInspection": {
      "title": "Billet Incoming Inspection",
      "description": "IQC inspection record for aluminum billets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "heat_number": { "type": "string" },
        "billet_size": { "type": "string" },
        "grade": { "type": "string" },
        "supplier_name": { "type": "string" },
        "inspector_name": { "type": "string" },
        "batch_no": { "type": "string" },
        "invoice_no": { "type": "string" },
        "judgement": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["heat_number", "grade", "supplier_name", "inspector_name"]
    },
    "InstrumentRecord": {
      "title": "Instrument Metrology Record",
      "description": "Calibration and tool record for QC lab equipment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "serialNo": { "type": "string" },
        "location": { "type": "string" },
        "spec": { "type": "number" },
        "frequency": { "type": "number" },
        "lastResult": { "type": "string" }
      },
      "required": ["id", "name", "spec", "frequency"]
    },
    "BilletCuttingRecord": {
      "title": "Billet Cutting Inspection Record",
      "description": "IPQA inspection log for billet cutting process",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "date": { "type": "string" },
        "shift": { "type": "string" },
        "inspectorName": { "type": "string" },
        "lotNo": { "type": "string" },
        "cuttingLength": { "type": "string" },
        "machine": { "type": "string" },
        "overallJudgement": { "type": "string", "enum": ["PASS", "FAIL"] }
      },
      "required": ["id", "timestamp", "shift", "inspectorName", "lotNo", "overallJudgement"]
    },
    "FgPreShipmentRecord": {
      "title": "FG Pre-Shipment Inspection Record",
      "description": "OQA-01 Finished Goods Pre-Shipment Label and Packaging Inspection Log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "docId": { "type": "string" },
        "timestamp": { "type": "string" },
        "inspectorName": { "type": "string" },
        "destinationTo": { "type": "string" },
        "profileName": { "type": "string" },
        "partNo": { "type": "string" },
        "boxNo": { "type": "string" },
        "result": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["id", "inspectorName", "partNo", "result"]
    },
    "QAInspector": {
      "title": "QA Inspector Staff Member",
      "description": "Employee record for QA inspectors across IQA, IPQA, and OQA",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empCode": { "type": "string" },
        "name": { "type": "string" },
        "nameEn": { "type": "string" },
        "startDate": { "type": "string" },
        "department": { "type": "string", "enum": ["IQA", "IPQA", "OQA", "QA_ALL", "METROLOGY"] },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "empCode", "name", "startDate", "status"]
    }
  },
  "firestore": {
    "/qa_master_data/{key}": {
      "schema": { "type": "object" },
      "description": "Master synchronized real-time state for modules and specs"
    },
    "/inspection_activities/{activityId}": {
      "schema": { "$ref": "#/entities/InspectionActivity" },
      "description": "Collection of global inspection activities"
    },
    "/billet_inspections/{billetId}": {
      "schema": { "$ref": "#/entities/BilletInspection" },
      "description": "Collection of billet incoming quality inspection logs"
    },
    "/instruments/{instrumentId}": {
      "schema": { "$ref": "#/entities/InstrumentRecord" },
      "description": "Collection of calibration instruments and tools"
    },
    "/oqa_inspections/{recordId}": {
      "schema": { "$ref": "#/entities/FgPreShipmentRecord" },
      "description": "Collection of OQA-01 pre-shipment inspection logs"
    },
    "/qa_inspectors/{inspectorId}": {
      "schema": { "$ref": "#/entities/QAInspector" },
      "description": "Collection of QA Inspector roster staff documents"
    }
  }
}
